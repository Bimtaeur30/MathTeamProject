.root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;

    background-color: rgb(18, 0, 35);

    background-image: linear-gradient(
        135deg,
        rgb(255, 0, 120),
        rgb(255, 230, 0),
        rgb(0, 255, 190),
        rgb(80, 0, 255),
        rgb(255, 40, 0)
    );

    -unity-font-style: bold;
    overflow: hidden;
}

.noise-layer {
    position: absolute;
    left: -20%;
    top: -20%;
    width: 140%;
    height: 140%;

    background-color: rgba(255, 255, 255, 0.08);
    border-width: 12px;
    border-color: rgba(0, 0, 0, 0.35);

    rotate: 12deg;
}

.title {
    font-size: 96px;
    color: rgb(255, 255, 0);

    -unity-text-outline-width: 8px;
    -unity-text-outline-color: rgb(255, 0, 170);

    letter-spacing: 14px;
    margin-bottom: 8px;

    text-shadow: 8px 8px 0 rgb(0, 255, 255);
}

.subtitle {
    font-size: 28px;
    color: white;

    -unity-text-outline-width: 4px;
    -unity-text-outline-color: black;

    margin-bottom: 28px;
}

.slot-box {
    width: 760px;
    padding: 22px;
    margin-bottom: 28px;

    background-color: rgba(0, 0, 0, 0.65);

    border-width: 8px;
    border-color: rgb(255, 255, 0);
    border-radius: 24px;

    align-items: center;
}

.reel {
    width: 100%;
    height: 56px;

    font-size: 30px;
    -unity-text-align: middle-center;

    margin-top: 6px;
    margin-bottom: 6px;

    border-width: 4px;
    border-radius: 12px;

    -unity-text-outline-width: 3px;
    -unity-text-outline-color: black;
}

.reel-a {
    color: rgb(0, 255, 255);
    background-color: rgb(80, 0, 255);
    border-color: rgb(255, 0, 255);
}

.reel-b {
    color: rgb(255, 255, 0);
    background-color: rgb(255, 0, 80);
    border-color: rgb(0, 255, 120);
}

.reel-c {
    color: white;
    background-color: rgb(0, 180, 90);
    border-color: rgb(255, 255, 255);
}

.main-button {
    width: 420px;
    height: 92px;

    font-size: 42px;
    color: black;

    background-color: rgb(255, 255, 0);

    border-width: 8px;
    border-color: rgb(255, 0, 120);
    border-radius: 28px;

    -unity-text-outline-width: 3px;
    -unity-text-outline-color: white;

    margin-top: 10px;
    margin-bottom: 12px;
}

.main-button:hover {
    background-color: rgb(0, 255, 255);
    scale: 1.12 1.12;
}

.sub-button {
    width: 280px;
    height: 54px;

    font-size: 24px;
    color: white;

    background-color: rgba(0, 0, 0, 0.65);

    border-width: 4px;
    border-color: rgb(255, 255, 255);
    border-radius: 16px;

    margin-top: 6px;
}

.sub-button:hover {
    background-color: rgb(255, 0, 120);
    scale: 1.08 1.08;
}

.warning {
    position: absolute;
    bottom: 24px;

    font-size: 22px;
    color: rgb(255, 255, 0);

    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(255, 0, 0);
}

.chaos-left {
    translate: -18px 0;
    rotate: -4deg;
    scale: 1.03 0.97;
}

.chaos-right {
    translate: 18px 0;
    rotate: 4deg;
    scale: 0.97 1.03;
}

.chaos-spin-left {
    rotate: -8deg;
    scale: 1.08 0.94;
}

.chaos-spin-right {
    rotate: 8deg;
    scale: 0.94 1.08;
}

.chaos-wiggle,
.chaos-rotate,
.main-button,
.sub-button,
.reel {
    transition-property: translate, rotate, scale, background-color;
    transition-duration: 80ms;
    transition-timing-function: ease-in-out;
}