/* SlotMachineTitle.uss */

.root {
    width: 100%;
    height: 100%;
    background-color: rgb(18, 0, 35);
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

/* 배경 */
.bg-chaos {
    position: absolute;
    width: 120%;
    height: 120%;
    left: -10%;
    top: -10%;

    background-image: linear-gradient(
        135deg,
        rgb(255, 0, 120),
        rgb(255, 230, 0),
        rgb(0, 255, 255),
        rgb(140, 0, 255),
        rgb(255, 80, 0)
    );

    opacity: 0.85;
}

/* 뒤에 깔리는 정신없는 패턴 */
.pattern-layer {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 8px;
    border-color: rgba(255, 255, 255, 0.25);
}

/* 메인 패널 */
.title-panel {
    width: 820px;
    height: 620px;

    justify-content: center;
    align-items: center;

    background-color: rgba(20, 0, 45, 0.88);

    border-width: 10px;
    border-color: rgb(255, 230, 0);
    border-radius: 36px;

    padding: 36px;

    -unity-text-align: middle-center;
}

/* 게임 타이틀 */
.game-title {
    font-size: 84px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);

    -unity-text-outline-width: 6px;
    -unity-text-outline-color: rgb(255, 0, 140);

    margin-bottom: 8px;
}

/* 부제목 */
.sub-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(0, 255, 255);

    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(80, 0, 120);

    margin-bottom: 32px;
}

/* 슬롯 릴 영역 */
.slot-reel-box {
    width: 680px;
    height: 150px;

    flex-direction: row;
    justify-content: space-around;
    align-items: center;

    background-color: rgb(255, 245, 120);

    border-width: 8px;
    border-color: rgb(255, 0, 80);
    border-radius: 24px;

    margin-bottom: 34px;
    padding: 12px;
}

/* 슬롯 칸 */
.slot-cell {
    width: 120px;
    height: 120px;

    justify-content: center;
    align-items: center;

    background-color: rgb(255, 255, 255);

    border-width: 6px;
    border-color: rgb(0, 200, 255);
    border-radius: 20px;
}

/* 슬롯 심볼 */
.slot-symbol {
    font-size: 62px;
    -unity-font-style: bold;
    color: rgb(255, 0, 90);

    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(255, 230, 0);
}

/* 버튼 공통 */
.menu-button {
    width: 360px;
    height: 78px;

    justify-content: center;
    align-items: center;

    background-color: rgb(255, 0, 120);

    border-width: 6px;
    border-color: rgb(255, 255, 0);
    border-radius: 999px;

    color: white;
    font-size: 34px;
    -unity-font-style: bold;

    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(80, 0, 140);

    margin-top: 12px;
}

/* 버튼 hover */
.menu-button:hover {
    background-color: rgb(0, 255, 255);
    border-color: rgb(255, 0, 220);
    color: rgb(255, 255, 0);

    scale: 1.08 1.08;
}

/* 버튼 클릭 */
.menu-button:active {
    background-color: rgb(255, 255, 0);
    border-color: rgb(0, 255, 120);
    color: rgb(255, 0, 120);

    scale: 0.94 0.94;
}

/* START 버튼만 더 정신없게 */
.start-button {
    width: 430px;
    height: 92px;

    background-color: rgb(255, 220, 0);
    border-color: rgb(255, 0, 120);

    color: rgb(255, 0, 120);
    font-size: 42px;

    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(0, 255, 255);
}

/* 구석 장식용 별 */
.star {
    position: absolute;
    width: 64px;
    height: 64px;

    justify-content: center;
    align-items: center;

    font-size: 48px;
    color: rgb(255, 255, 0);

    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(255, 0, 160);
}

.star-top-left {
    left: 40px;
    top: 30px;
}

.star-top-right {
    right: 40px;
    top: 30px;
}

.star-bottom-left {
    left: 50px;
    bottom: 40px;
}

.star-bottom-right {
    right: 50px;
    bottom: 40px;
}

/* 경고문 / 깜빡이는 느낌 줄 텍스트 */
.notice-text {
    font-size: 22px;
    color: rgb(255, 255, 0);

    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(255, 0, 0);

    margin-top: 18px;
}