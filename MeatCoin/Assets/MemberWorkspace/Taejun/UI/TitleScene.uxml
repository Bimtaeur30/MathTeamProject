        <ui:Button text="도 박 시 작" name="StartButton" class="main-button chaos-rotate"/>
        <ui:Button text="수열 공식 보기" name="FormulaButton" class="sub-button chaos-wiggle"/>
        <ui:Button text="도망가기" name="ExitButton" class="sub-button"/>
